# Copy to backend/.env and fill in only what you use. Every hosted provider is OPTIONAL.
# Shelfcraft never calls paid APIs; providers without a key simply stay disabled.
# Keys can also be entered in Settings → AI providers (stored server-side, never sent to the browser).

# --- Optional free-tier text providers ---------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=          # only models ending in ":free" are ever used
# MISTRAL_API_KEY=           # adapter present but disabled: free tier could not be verified

# --- Optional Cloudflare Workers AI (text + image, 10k free Neurons/day) ------
# Use an account on the Workers FREE plan so overage billing is impossible.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Local AI -----------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- App ----------------------------------------------------------------------
# SHELFCRAFT_ACCESS_TOKEN=change-me     # require this token for all API calls (recommended on shared PCs)
# SHELFCRAFT_DATA_DIR=C:/Users/you/ShelfcraftData
# SHELFCRAFT_MAX_UPLOAD_MB=25
# SHELFCRAFT_JOB_WORKERS=2
# SHELFCRAFT_HEAVY_JOB_SLOTS=1
# SHELFCRAFT_FFMPEG_DIR=C:/ffmpeg/bin
